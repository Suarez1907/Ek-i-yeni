            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item
                    android:offset="0.0"
                    android:color="#080D09" />
                <item
                    android:offset="0.52"
                    android:color="#0D1911" />
                <item
                    android:offset="1.0"
                    android:color="#080D09" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hafif İnce Köşe Işıltısı -->
    <path
        android:pathData="M0,0 L108,0 L108,38 L0,76 Z"
        android:fillAlpha="0.16"
        android:fillColor="#1B3B22" />
